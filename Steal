local function performStealOnce()
    if isStealing then return false end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    if Remotes:FindFirstChild("InventoryRemotes") and Remotes.InventoryRemotes:FindFirstChild("StoreAllOfKind") then
        Remotes.InventoryRemotes.StoreAllOfKind:FireServer("All")
        task.wait(0.2)
    end

    local bestPrompt = nil
    local bestWeight = -1
    local bestPart = nil
    local bestModel = nil
    local bestDistanceZ = 999999

    local activeFolder = workspace:FindFirstChild("Runtime") and workspace.Runtime:FindFirstChild("ActiveSeeds")
    local searchScope = activeFolder and activeFolder:GetDescendants() or workspace:GetDescendants()

    for _, p in ipairs(searchScope) do
        if p:IsA("ProximityPrompt") and p.Enabled then
            local part = p.Parent
            if part and part:IsA("BasePart") then
                local model = part:FindFirstAncestorWhichIsA("Model")
                local rarity = model and model:GetAttribute("Rarity") or "Common"
                local species = model and model:GetAttribute("Species")
                local state = model and model:GetAttribute("State") or "Available"
                local carrier = model and model:GetAttribute("CarrierUserId") or 0

                if state == "Available" and carrier == 0 then
                    local weight = getSeedValue(rarity, species)
                    local distZ = math.abs(part.Position.Z)
                    if weight > bestWeight or (weight == bestWeight and distZ < bestDistanceZ) then
                        bestWeight = weight
                        bestDistanceZ = distZ
                        bestPrompt = p
                        bestPart = part
                        bestModel = model
                    end
                end
            end
        end
    end

    if bestPrompt and bestPart and hrp and hum then
        isStealing = true

        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)

        hrp.CFrame = CFrame.new(bestPart.Position + Vector3.new(0, 1.5, 0))
        task.wait(0.3)

        bestPrompt.HoldDuration = 0
        bestPrompt.RequiresLineOfSight = false
        bestPrompt.MaxActivationDistance = 999999

        local acquired = false
        for attempt = 1, 4 do
            if isHoldingSeed() then
                acquired = true
                break
            end

            if fireproximityprompt then
                fireproximityprompt(bestPrompt, 0, true)
            else
                bestPrompt:InputHoldBegin()
                task.wait(0.02)
                bestPrompt:InputHoldEnd()
            end
            task.wait(0.25)

            if isHoldingSeed() then
                acquired = true
                break
            end
        end

        if not acquired then
            isStealing = false
            return false
        end

        local tPickup = os.clock()
        local startZ = hrp.Position.Z

        local escapeY = math.max(bestPart.Position.Y + 2, 2.5)
        hrp.CFrame = CFrame.new(0, escapeY, hrp.Position.Z)
        task.wait(0.08)

        local speedPower = LocalPlayer:GetAttribute("SpeedPower") or 1000
        local maxLegitSpeed = SpeedConfig.GetMaxLegitimateSpeedForTrained(speedPower) or 50
        local sprintSpeed = math.clamp(Settings.ReturnSpeed or 350, 100, 700)

        local t0 = os.clock()
        while os.clock() - t0 < 25 do
            if not char or not hrp or not hum then break end
            if hrp.Position.Z <= 120 then break end

            hum.WalkSpeed = sprintSpeed
            hum:MoveTo(Vector3.new(0, hrp.Position.Y, hrp.Position.Z - 150))
            task.wait(0.04)
        end

        local t1 = os.clock()
        while os.clock() - t1 < 6 do
            if not char or not hrp or not hum then break end
            if hrp.Position.Z <= 10 then break end

            hum.WalkSpeed = 45
            hum:MoveTo(Vector3.new(0, 0, 10))
            task.wait(0.03)
        end

        hum:MoveTo(hrp.Position)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hum.WalkSpeed = 16

        task.wait(0.8)

        local noclipConn = RunService.Stepped:Connect(function()
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)

        local crossTime = os.clock()
        hum.WalkSpeed = 24
        while os.clock() - crossTime < 8 do
            if not char or not hrp or not hum then break end
            if LocalPlayer:GetAttribute("HallCarrier") ~= true and hrp.Position.Z <= -10 then
                break
            end
            if hrp.Position.Z <= -28 then
                break
            end
            hum:Move(Vector3.new(0, 0, -1), false)
            hum:MoveTo(Vector3.new(hrp.Position.X, hrp.Position.Y, -32))
            task.wait(0.03)
        end

        if noclipConn then
            noclipConn:Disconnect()
        end

        hum:MoveTo(hrp.Position)
        task.wait(0.5)

        if Remotes:FindFirstChild("InventoryRemotes") and Remotes.InventoryRemotes:FindFirstChild("StoreAllOfKind") then
            Remotes.InventoryRemotes.StoreAllOfKind:FireServer("All")
            task.wait(0.3)
        end

        pcall(plantStoredSeeds)

        isStealing = false
        return true
    end
    return false
end

