local function getMyBase()
    if workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Bases") then
        for _, b in ipairs(workspace.Map.Bases:GetChildren()) do
            if b:GetAttribute("OwnerUserId") == LocalPlayer.UserId or b:GetAttribute("OwnerName") == LocalPlayer.Name then
                return b
            end
        end
    end
    return nil
end

local function isHoldingSeed()
    if LocalPlayer:GetAttribute("HallCarrier") == true then
        return true
    end
    local char = LocalPlayer.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child.Name:sub(1, 12) == "CarriedSeed_" then
                return true
            end
        end
    end
    local activeFolder = workspace:FindFirstChild("Runtime") and workspace.Runtime:FindFirstChild("ActiveSeeds")
    if activeFolder then
        for _, s in ipairs(activeFolder:GetChildren()) do
            if s:GetAttribute("CarrierUserId") == LocalPlayer.UserId and s:GetAttribute("State") == "Carried" then
                return true
            end
        end
    end
    return false
end

local function getSeedValue(rarity, species)
    local rWeight = RarityWeights[rarity or ""] or 1
    local income = 0
    if species and SeedConfig and SeedConfig.GetIncome then
        pcall(function()
            income = SeedConfig.GetIncome(species) or 0
        end)
    end
    return (rWeight * 1000000000) + income
end

local function plantStoredSeeds()
    local myBase = getMyBase()
    if not myBase then return false end

    local activeTreesFolder = workspace:FindFirstChild("Runtime") and workspace.Runtime:FindFirstChild("ActiveTrees")
    local myTrees = activeTreesFolder and activeTreesFolder:FindFirstChild(myBase.Name)
    local currentTreeCount = myTrees and #myTrees:GetChildren() or 0
    if currentTreeCount >= 10 then return false end

    local inv = Remotes.InventoryRemotes.GetInventory:InvokeServer()
    local storedSeeds = inv and inv.StoredSeeds or {}
    if #storedSeeds == 0 then return false end

    table.sort(storedSeeds, function(a, b)
        local va = tonumber(a.BaseIncomePerSecond) or getSeedValue(a.Rarity, a.Species or a.Id)
        local vb = tonumber(b.BaseIncomePerSecond) or getSeedValue(b.Rarity, b.Species or b.Id)
        return va > vb
    end)

    local pivot = myBase:GetPivot()
    local sizeLevel = myBase:GetAttribute("GardenSizeLevel")
    local depthBonus = GardenSizeConfig.GetDepthBonus(sizeLevel)
    local radius = BaseConfig.GetTreeRadius("Normal")
    local center, size = BaseConfig.GetPlantableBounds(depthBonus)

    local validSpots = {}
    for ox = -size.X/2 + 4, size.X/2 - 4, 7 do
        for oz = -size.Y/2 + 4, size.Y/2 - 4, 7 do
            if BaseConfig.IsInsidePlantable(ox, oz, radius, depthBonus, false) and not BaseConfig.GetBlockingZone(ox, oz, radius) then
                local worldPt = pivot:PointToWorldSpace(Vector3.new(ox, 0.35, oz))
                local occupied = false
                if myTrees then
                    for _, tr in ipairs(myTrees:GetChildren()) do
                        if (tr:GetPivot().Position - worldPt).Magnitude < 5 then
                            occupied = true
                            break
                        end
                    end
                end
                if not occupied then
                    table.insert(validSpots, worldPt)
                end
            end
        end
    end

    if #validSpots == 0 then return false end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(pivot.Position + Vector3.new(0, 3, 0))
        task.wait(0.3)
    end

    local availableSlots = 10 - currentTreeCount
    local planted = 0
    for i, seed in ipairs(storedSeeds) do
        if planted >= availableSlots or i > #validSpots then break end
        local spot = validSpots[i]
        if not spot then break end

        Remotes.InventoryRemotes.MoveToHotbar:FireServer("Seed", seed.Uid, 3)
        task.wait(0.2)
        Remotes.BaseRemotes.RequestPlantSeed:FireServer(seed.Uid, spot)
        task.wait(0.25)
        planted = planted + 1
    end

    return planted > 0
end

local function applyGuardImmunity()
    pcall(function()
        local GuardComponent = require(ReplicatedStorage:WaitForChild("Library"):WaitForChild("Modules"):WaitForChild("GuardAreas"):WaitForChild("GuardComponent"))
        if GuardComponent then
            GuardComponent._attemptAttack = function() end
        end
    end)

    pcall(function()
        local Network = require(ReplicatedStorage:WaitForChild("Library"):WaitForChild("Client"):WaitForChild("Network"))
        if not getgenv().GuardHitBlocked then
            getgenv().GuardHitBlocked = true
            local oldFire = Network.Fire
            Network.Fire = function(endpoint, args)
                if typeof(endpoint) == "string" and (endpoint:find("Hit") or endpoint:find("Deposit") or endpoint:find("Guard")) then
                    return
                end
                return oldFire(endpoint, args)
            end
        end
    end)

    pcall(function()
        local Knockback = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Modules"):WaitForChild("Knockback"))
        Knockback.Apply = function() end
    end)

    pcall(function()
        if not getgenv().GuardHookNamecallInstalled and hookmetamethod then
            getgenv().GuardHookNamecallInstalled = true
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                local method = getnamecallmethod()
                if (method == "FireServer" or method == "fireServer") and typeof(self) == "Instance" then
                    local name = self.Name
                    if (self.Parent and self.Parent.Name == "SagGuardBridge") or name:find("GuardHit") or name:find("ForestHit") or name:find("ForestDeposit") or name:find("GuardDeposit") then
                        return
                    end
                end
                return oldNamecall(self, ...)
            end))
        end
    end)

    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        end
    end)
end

